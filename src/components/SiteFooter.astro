---
import { site } from "../data/site";
---

<footer
  class="w-full bg-surface-container-lowest border-t border-outline-border py-12 text-xs font-mono text-on-surface-variant"
>
  <div
    class="max-w-7xl mx-auto px-6 lg:px-12 flex flex-col md:flex-row items-start md:items-center justify-between gap-6"
  >
    <div class="flex flex-col gap-2 max-w-lg">
      <div class="flex items-center gap-3">
        <span
          class="font-headline text-lg font-bold text-on-surface tracking-tight"
          >{site.name} ({site.nameLocal})</span
        >
        <span
          class="px-2.5 py-0.5 rounded-full bg-secondary-container text-on-secondary-fixed font-mono text-[10px] font-bold"
          >SCUT · AI</span
        >
      </div>
      <p
        class="font-body text-xs md:text-sm text-on-surface-variant leading-relaxed"
      >
        Undergraduate AI Researcher at <span class="text-on-surface font-medium"
          >South China University of Technology</span
        >. Active member of <a
          href="https://scuthcc.top/"
          target="_blank"
          class="underline decoration-secondary decoration-1 underline-offset-2 hover:text-on-surface"
          >HAI Lab</a
        > &amp; <a
          href="http://hdmilab.cn/"
          target="_blank"
          class="underline decoration-secondary decoration-1 underline-offset-2 hover:text-on-surface"
          >HDMI Lab</a
        >.
      </p>
    </div>
    <div class="flex flex-col sm:flex-row gap-6 lg:gap-10 text-xs font-mono">
      <div class="space-y-1.5">
        <div class="flex items-center gap-2">
          <span
            class="text-on-surface-variant/80 uppercase text-[10px] tracking-wider"
            >Email</span
          >
          <a
            href={`mailto:${site.email}`}
            class="text-on-surface hover:text-secondary font-medium underline underline-offset-2"
            >{site.email}</a
          >
        </div>
        <div class="flex items-center gap-2">
          <span
            class="text-on-surface-variant/80 uppercase text-[10px] tracking-wider"
            >Phone</span
          >
          <a
            href={`tel:${site.phoneHref}`}
            class="text-on-surface hover:text-secondary font-medium"
            >{site.phone}</a
          >
        </div>
        <div class="flex items-center gap-2">
          <span
            class="text-on-surface-variant/80 uppercase text-[10px] tracking-wider"
            >Base</span
          >
          <span class="text-on-surface font-medium">{site.location}</span>
        </div>
      </div>
      <div
        class="flex flex-col sm:items-end justify-center gap-1.5 border-t sm:border-t-0 sm:border-l border-outline-border/50 pt-3 sm:pt-0 sm:pl-6"
      >
        <div
          class="inline-flex items-center gap-2 px-3 py-1 bg-secondary-container text-on-secondary-fixed rounded-full text-xs font-bold shadow-[2px_2px_0px_#141414]"
        >
          <span class="w-1.5 h-1.5 rounded-full bg-secondary animate-pulse"
          ></span>
          <span class="">Fall 2027 PhD Applicant</span>
        </div>
        <span class="text-[11px] text-on-surface-variant font-mono"
          >Expected Grad: June 2027</span
        >
      </div>
    </div>
  </div>
</footer>
