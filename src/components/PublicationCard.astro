---
import type { Publication } from "../data/types";
import { site } from "../data/site";
import { mediaUrl } from "../lib/media";

interface Props {
  publication: Publication;
  index: number;
}
const { publication: paper, index } = Astro.props;
// Stitch preview images are design placeholders, not verified research figures.
// A real image path automatically enables the project image here.
const hasVerifiedImage = Boolean(
  paper.image?.src && !paper.image.src.endsWith("/stitch-preview.jpg"),
);
---

<article
  id={paper.id}
  class="pub-card"
  data-categories={paper.categories.join(" ")}
>
  <div class="publication-art">
    {
      hasVerifiedImage && paper.image ? (
        <img
          src={mediaUrl(paper.image.src)}
          alt={paper.image.alt}
          style={{ objectPosition: paper.image.objectPosition ?? "center" }}
          loading="lazy"
          decoding="async"
        />
      ) : (
        <div class="publication-art-placeholder" aria-hidden="true">
          <>
            <span>{String(index).padStart(2, "0")}</span>
            <span>✳</span>
          </>
        </div>
      )
    }
  </div>
  <div class="publication-copy">
    <div class="publication-meta">
      <span>{paper.venue}</span><span class="meta-dot" aria-hidden="true"
        >·</span
      ><span>{paper.status}</span>
    </div>
    <h4>{paper.title}</h4>
    <p class="publication-authors">
      {
        paper.authors.map((author, authorIndex) => (
          <>
            {authorIndex > 0 ? ", " : ""}
            {author.replace(/\*+$/, "") === site.name ? (
              <strong>{author}</strong>
            ) : (
              author
            )}
          </>
        ))
      }
    </p>
    <div class="publication-bottom">
      {paper.role && <span class="publication-role">{paper.role}</span>}
      {paper.award && <span class="publication-award">✦ {paper.award}</span>}
      {
        paper.links.map((link) => (
          <a
            href={
              link.href.startsWith("mailto:")
                ? link.href.replace(/^mailto:[^?]+/, `mailto:${site.email}`)
                : link.href
            }
            target={link.href.startsWith("https://") ? "_blank" : undefined}
            rel={
              link.href.startsWith("https://")
                ? "noopener noreferrer"
                : undefined
            }
            class="publication-link"
          >
            {link.label} <span aria-hidden="true">↗</span>
          </a>
        ))
      }
      {
        paper.bibtex && (
          <button
            type="button"
            class="publication-link"
            data-copy-bibtex={paper.bibtex}
            aria-label={`Copy BibTeX for ${paper.title}`}
          >
            Copy BibTeX <span aria-hidden="true">⧉</span>
          </button>
        )
      }
    </div>
  </div>
</article>
