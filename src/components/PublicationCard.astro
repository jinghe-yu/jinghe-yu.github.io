---
import type { Publication } from "../data/types";
import { site } from "../data/site";
import { mediaUrl } from "../lib/media";

interface Props {
  publication: Publication;
  index: number;
}
const { publication: paper, index } = Astro.props;
// Stitch preview images are design placeholders, not verified research figures.
// A real image path automatically enables the project image here.
const hasVerifiedImage = Boolean(
  paper.image?.src && !paper.image.src.endsWith("/stitch-preview.jpg"),
);
const imageUrl =
  hasVerifiedImage && paper.image ? mediaUrl(paper.image.src) : null;
const imageShape = !paper.image
  ? "placeholder"
  : paper.image.height > paper.image.width
    ? "portrait"
    : paper.image.width / paper.image.height > 2.1
      ? "wide"
      : "landscape";
const isAnimated = paper.image?.src.toLowerCase().endsWith(".gif") ?? false;
---

<article
  id={paper.id}
  class="pub-card"
  data-categories={paper.categories.join(" ")}
  data-abstract-open="false"
>
  <div class="publication-art" data-image-shape={imageShape}>
    {
      imageUrl && paper.image ? (
        <a
          href={imageUrl}
          class="publication-art-link"
          target="_blank"
          rel="noopener noreferrer"
          aria-label={`View full-size ${isAnimated ? "GIF" : "image"} for ${paper.title}`}
        >
          <img
            src={imageUrl}
            alt={paper.image.alt}
            width={paper.image.width}
            height={paper.image.height}
            loading="lazy"
            decoding="async"
          />
          <span class="publication-open-icon" aria-hidden="true">
            ↗
          </span>
        </a>
      ) : (
        <div class="publication-art-placeholder" aria-hidden="true">
          <>
            <span>{String(index).padStart(2, "0")}</span>
            <span>✳</span>
          </>
        </div>
      )
    }
  </div>
  <div class="publication-copy">
    <div class="publication-meta">
      <span>{paper.venue}</span><span class="meta-dot" aria-hidden="true"
        >·</span
      ><span>{paper.status}</span>
    </div>
    <h4>{paper.title}</h4>
    <p class="publication-authors">
      {
        paper.authors.map((author, authorIndex) => (
          <>
            {authorIndex > 0 ? ", " : ""}
            {author.replace(/\*+$/, "") === site.name ? (
              <strong>{author}</strong>
            ) : (
              author
            )}
          </>
        ))
      }
    </p>
    <ul class="publication-tags" aria-label="Research topics">
      {paper.tags.map((tag) => <li>#{tag}</li>)}
    </ul>
    <div class="publication-bottom">
      {paper.role && <span class="publication-role">{paper.role}</span>}
      {paper.award && <span class="publication-award">✦ {paper.award}</span>}
      {
        paper.abstract && (
          <button
            id={`abstract-toggle-${paper.id}`}
            type="button"
            class="publication-link publication-abstract-toggle"
            data-abstract-toggle
            aria-expanded="false"
            aria-controls={`abstract-panel-${paper.id}`}
          >
            Abstract{" "}
            <span class="abstract-toggle-glyph" aria-hidden="true">
              +
            </span>
          </button>
        )
      }
      {
        paper.links.map((link) => (
          <a
            href={
              link.href.startsWith("mailto:")
                ? link.href.replace(/^mailto:[^?]+/, `mailto:${site.email}`)
                : link.href.startsWith("/")
                  ? mediaUrl(link.href)
                  : link.href
            }
            target={
              link.href.startsWith("https://") || link.href.startsWith("/")
                ? "_blank"
                : undefined
            }
            rel={
              link.href.startsWith("https://") || link.href.startsWith("/")
                ? "noopener noreferrer"
                : undefined
            }
            class:list={[
              "publication-link",
              link.label === "Demo" && "publication-demo-link",
              link.label === "PDF" && "publication-pdf-link",
            ]}
            aria-label={
              link.label === "Demo"
                ? `Watch demo for ${paper.title}`
                : link.label === "PDF"
                  ? `Read PDF for ${paper.title}`
                  : undefined
            }
          >
            {link.label === "Demo" && <span aria-hidden="true">▶</span>}
            {link.label === "PDF" && (
              <svg aria-hidden="true" viewBox="0 0 16 16" fill="none">
                <path
                  d="M4 1.5h5.5L13 5v9.5H4z"
                  stroke="currentColor"
                  stroke-width="1.3"
                  stroke-linejoin="round"
                />
                <path
                  d="M9.5 1.5V5H13M6 8h5M6 10.5h5"
                  stroke="currentColor"
                  stroke-width="1.3"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                />
              </svg>
            )}
            {link.label}
            {link.label !== "Demo" && link.label !== "PDF" && (
              <span aria-hidden="true">↗</span>
            )}
          </a>
        ))
      }
      {
        paper.bibtex && (
          <button
            type="button"
            class="publication-link"
            data-copy-bibtex={paper.bibtex}
            aria-label={`Copy BibTeX for ${paper.title}`}
          >
            Copy BibTeX <span aria-hidden="true">⧉</span>
          </button>
        )
      }
    </div>
    {
      paper.abstract && (
        <div
          id={`abstract-panel-${paper.id}`}
          class="publication-abstract"
          role="region"
          aria-labelledby={`abstract-toggle-${paper.id}`}
          aria-hidden="true"
          inert
        >
          <div class="publication-abstract-clip">
            <div class="publication-abstract-card">
              <div class="publication-abstract-heading">
                <span>Abstract</span>
                <span aria-hidden="true">✳</span>
              </div>
              <p>{paper.abstract}</p>
            </div>
          </div>
        </div>
      )
    }
  </div>
</article>
