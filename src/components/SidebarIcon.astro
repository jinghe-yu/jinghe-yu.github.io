---
interface Props {
  name: "phone" | "email" | "wechat" | "github" | "cv";
}

const { name } = Astro.props;
---

<svg
  class="sidebar-icon"
  aria-hidden="true"
  focusable="false"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.65"
  stroke-linecap="round"
  stroke-linejoin="round"
>
  {
    name === "phone" && (
      <path d="M5.3 3.2 8 2.7l2 4.1-1.7 1.5a15 15 0 0 0 7.4 7.4l1.5-1.7 4.1 2-.5 2.7c-.1 1-.9 1.8-1.9 1.9C9.6 20.9 3.1 14.4 3.4 5.1c0-1 .8-1.8 1.9-1.9Z" />
    )
  }
  {
    name === "email" && (
      <>
        <rect x="2.75" y="5" width="18.5" height="14" rx="2.5" />
        <path d="m3.5 7 8.5 6 8.5-6" />
      </>
    )
  }
  {
    name === "wechat" && (
      <>
        <path d="M14.5 10.1c-.5-3.8-4-6.7-8-6.1C3 4.5 1 7 1 10c0 1.8.9 3.4 2.4 4.5L3 17l2.7-.9c.8.2 1.6.3 2.4.3" />
        <path d="M15.1 10c4.2 0 7.4 2.5 7.4 5.6 0 1.7-.9 3.1-2.5 4.2l.5 2.1-2.7-.8c-.9.3-1.8.4-2.7.4-4.2 0-7.4-2.6-7.4-5.9s3.2-5.6 7.4-5.6Z" />
        <circle cx="12.4" cy="15.4" r=".55" fill="currentColor" stroke="none" />
        <circle cx="17.8" cy="15.4" r=".55" fill="currentColor" stroke="none" />
      </>
    )
  }
  {
    name === "github" && (
      <path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.9a3.4 3.4 0 0 0-.9-2.6c3.1-.4 6.4-1.5 6.4-7A5.4 5.4 0 0 0 20 4.8 5 5 0 0 0 19.9 1S18.7.7 16 3.5a13.4 13.4 0 0 0-7 0C6.3.7 5.1 1 5.1 1A5 5 0 0 0 5 4.8a5.4 5.4 0 0 0-1.5 3.7c0 5.5 3.3 6.6 6.4 7a3.4 3.4 0 0 0-.9 2.6V22" />
    )
  }
  {
    name === "cv" && (
      <>
        <path d="M5 2.75h9l5 5V21H5z" />
        <path d="M14 2.75v5h5M8 12h8M8 15.5h8M8 19h5" />
      </>
    )
  }
</svg>
