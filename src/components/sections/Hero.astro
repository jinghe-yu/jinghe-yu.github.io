---
import { site } from "../../data/site";
import { publications } from "../../data/publications";
import Portrait from "../media/Portrait.astro";
---

<section class="w-full max-w-7xl mx-auto px-6 lg:px-12 pt-10 pb-12" id="about">
  <div
    class="flex flex-wrap items-center justify-between gap-4 pb-6 mb-8 border-b border-outline-border"
  >
    <div
      class="inline-flex items-center gap-2 px-3.5 py-1.5 bg-secondary-container text-on-secondary-fixed rounded-full shadow-[2px_2px_0px_#141414] text-[11px] font-mono font-bold"
    >
      <span class="w-2 h-2 rounded-full bg-secondary animate-pulse"></span>
      <span class="">Expected Grad June 2027</span>
    </div>
    <div class="text-xs font-mono text-on-surface-variant">
      South China University of Technology (SCUT) · {site.location}
    </div>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
    <!-- Left: Bio Statement -->
    <div class="lg:col-span-8 flex flex-col gap-6">
      <div>
        <h1
          class="font-headline text-5xl lg:text-7xl font-extrabold text-on-surface tracking-tight leading-none mb-3"
        >
          {site.name}
          <span class="text-3xl lg:text-4xl font-normal text-on-surface-variant"
            >({site.nameLocal})</span
          >
        </h1>
        <p class="font-mono text-sm text-on-surface font-semibold">
          Human-Centered AI | Human-Computer Interaction · Affective Computing
        </p>
      </div>

      <p
        class="text-base lg:text-lg text-on-surface-variant max-w-3xl leading-relaxed"
      >
        I am an undergraduate AI researcher at South China University of
        Technology (SCUT, CGPA 3.55/4.00, Score 87.27/100), working at the
        intersection of Human-Computer Interaction, Affective Computing, and
        Multimodal Healthcare Analytics. Advised by Prof. Zhanpeng Jin, Prof.
        Yang Gao, and Prof. Yanwu Xu.
      </p>

      <!-- CTAs -->
      <div class="flex flex-wrap items-center gap-3 pt-1">
        <a
          href="#publications"
          class="inline-flex items-center gap-2 bg-primary text-on-primary font-mono text-xs uppercase px-5 py-2.5 rounded shadow-[2px_2px_0px_#141414] hover:bg-secondary-container hover:text-on-secondary-fixed transition font-bold"
        >
          <span class="">Publications ({publications.length} Papers)</span>
          <svg
            class="w-4 h-4"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"><path d="M7 13l5 5 5-5M12 4v14"></path></svg
          >
        </a>

        <a
          href={`mailto:${site.email}`}
          class="font-mono text-xs text-on-surface-variant hover:text-on-surface underline decoration-secondary decoration-2 underline-offset-4 ml-1"
        >
          {site.email} →
        </a>
      </div>

      <!-- Academic Dossier Strip (Verbatim from CV) -->
      <div
        class="grid grid-cols-2 sm:grid-cols-4 gap-4 pt-6 max-w-3xl border-t border-outline-border"
      >
        <div>
          <span class="block font-mono text-base font-bold text-on-surface"
            >{publications.length} Papers</span
          >
          <span class="font-mono text-[10px] text-on-surface-variant uppercase"
            >{
              publications.filter((paper) => paper.group === "published").length
            } Accepted / Published · {
              publications.filter((paper) => paper.group === "submitted").length
            } Submitted</span
          >
        </div>
        <div>
          <span class="block font-mono text-base font-bold text-on-surface"
            >CGPA 3.55 / 4.00</span
          >
          <span class="font-mono text-[10px] text-on-surface-variant uppercase"
            >Avg Score: 87.27 / 100</span
          >
        </div>
        <div>
          <span class="block font-mono text-base font-bold text-on-surface"
            >IELTS 6.5</span
          >
          <span class="font-mono text-[10px] text-on-surface-variant uppercase"
            >CET-6 577 · CET-4 608</span
          >
        </div>
        <div>
          <span class="block font-mono text-base font-bold text-on-surface"
            >HAI &amp; HDMI Labs</span
          >
          <span class="font-mono text-[10px] text-on-surface-variant uppercase"
            >SCUT Dual Research</span
          >
        </div>
      </div>
    </div>

    <!-- Right: Research Interests Statement (Verbatim from main.md) -->
    <div
      class="lg:col-span-4 p-6 bg-surface-container-lowest border border-outline-border rounded-xl shadow-[4px_4px_0px_#141414] space-y-4"
    >
      <Portrait />
      <div>
        <span
          class="font-mono text-[10px] text-secondary uppercase font-bold tracking-widest block mb-1"
          >Verbatim Statement</span
        >
        <h2 class="font-headline text-lg font-bold text-on-surface">
          Research Interests
        </h2>
      </div>
      <p class="text-sm text-on-surface">
        My primary research interest is <strong class="font-bold"
          >Human-Centered AI</strong
        >, with a focus on:
      </p>
      <ul class="space-y-2.5 text-sm">
        <li
          class="flex items-center gap-3 p-3 bg-surface-container-low rounded border-l-4 border-secondary"
        >
          <svg
            class="w-5 h-5 text-secondary shrink-0"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            ><path d="M18 11V6a2 2 0 0 0-2-2v0a2 2 0 0 0-2 2v0"></path><path
              d="M14 10V4a2 2 0 0 0-2-2v0a2 2 0 0 0-2 2v2"></path><path
              d="M10 10.5V6a2 2 0 0 0-2-2v0a2 2 0 0 0-2 2v8"></path><path
              d="M18 8a2 2 0 1 1 4 0v6a8 8 0 0 1-8 8h-2c-2.8 0-4.5-.86-5.99-2.34l-3.6-3.6a2 2 0 0 1 2.83-2.82L7 15"
            ></path></svg
          >
          <span class="font-semibold text-on-surface"
            >Human-Computer Interaction</span
          >
        </li>
        <li
          class="flex items-center gap-3 p-3 bg-surface-container-low rounded border-l-4 border-secondary"
        >
          <svg
            class="w-5 h-5 text-secondary shrink-0"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"><path d="M22 12h-4l-3 9L9 3l-3 9H2"></path></svg
          >
          <span class="font-semibold text-on-surface"
            >Multimodal Healthcare Analytics</span
          >
        </li>
        <li
          class="flex items-center gap-3 p-3 bg-surface-container-low rounded border-l-4 border-secondary"
        >
          <svg
            class="w-5 h-5 text-secondary shrink-0"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            ><path
              d="M12 2a9 9 0 0 0-9 9c0 3.6 2.1 6.7 5.2 8.1.3.1.5.4.5.8v1.1c0 .6.4 1 1 1h4.6c.6 0 1-.4 1-1v-1.1c0-.4.2-.7.5-.8A9 9 0 0 0 12 2z"
            ></path><path d="M9 13h6"></path><path d="M10 17h4"></path></svg
          >
          <span class="font-semibold text-on-surface">Affective Computing</span>
        </li>
      </ul>
      <div
        class="pt-3 border-t border-outline-border font-mono text-[11px] text-on-surface-variant space-y-1"
      >
        <div class="flex justify-between">
          <span class="">Location:</span><span class="text-on-surface font-bold"
            >{site.location}</span
          >
        </div>
        <div class="flex justify-between">
          <span class="">Degree Track:</span><span
            class="text-on-surface font-bold">B.Eng. AI (2023–2027)</span
          >
        </div>
        <div class="flex justify-between">
          <span class="">Advising Target:</span><span
            class="text-on-surface font-bold">Fall 2027 PhD</span
          >
        </div>
      </div>
    </div>
  </div>
</section>
