---
import { site } from "../../data/site";
---

<section
  id="about"
  class="content-section intro-section"
  aria-labelledby="about-title"
>
  <div class="section-kicker">
    <span class="kicker-index">01 / Introduction</span><span class="kicker-rule"
    ></span><span>Guangzhou, China</span>
  </div>
  <p class="intro-hello">Hello, I'm Jinghe <span aria-hidden="true">✳</span></p>
  <h1 id="about-title">Designing AI that feels <em>more human.</em></h1>
  <div class="intro-grid">
    <div class="intro-copy">
      <p>
        I am an undergraduate researcher in Artificial Intelligence at{" "}
        <strong>South China University of Technology</strong>, exploring the
        space between{" "}<strong>Human–Computer Interaction</strong>, affective
        computing, and multimodal healthcare analytics.
      </p>
      <p>
        My work moves between interactive systems and empirical evaluation: how
        we design with people's lived experiences in mind, and how we evaluate
        whether intelligent technologies genuinely support them.
      </p>
      <p>
        I work with the Human-Centered AI Lab and the Healthcare Data and
        Medical Intelligence Lab at SCUT. I am preparing for PhD study in Fall
        2027.
      </p>
      <a class="text-link" href={`mailto:${site.email}`}
        >Research collaborations are welcome <span aria-hidden="true">↗</span
        ></a
      >
    </div>
    <div class="intro-aside">
      <span class="aside-star" aria-hidden="true">✦</span>
      <span class="aside-label">At a glance</span>
      <dl>
        <div><dt>Focus</dt><dd>Human-centered AI</dd></div>
        <div><dt>Based at</dt><dd>SCUT · Guangzhou</dd></div>
        <div><dt>Next chapter</dt><dd>PhD · Fall 2027</dd></div>
      </dl>
    </div>
  </div>
</section>
