---
import { publications, publicationFilters } from "../../data/publications";
import PublicationCard from "../PublicationCard.astro";

const preferredOrder = [
  "emomirror26",
  "emotype26",
  "touchsound26",
  "icimh2025",
  "aicabench26",
  "scidata26",
  "liqo",
  "posts-and-threads",
  "mental-health",
  "sentiment-boundaries",
  "ac-bench",
];
const rank = (id: string) => {
  const index = preferredOrder.indexOf(id);
  return index < 0 ? Number.MAX_SAFE_INTEGER : index;
};
const papers = [...publications].sort((a, b) => rank(a.id) - rank(b.id));
const groups = [
  {
    id: "published",
    title: "Accepted & published",
    note: "Peer-reviewed work",
  },
  {
    id: "submitted",
    title: "Under review & submitted",
    note: "Status as listed in CV",
  },
] as const;
---

<section
  id="publications"
  class="content-section"
  aria-labelledby="publications-title"
>
  <div class="section-heading">
    <span class="section-number">04</span><div>
      <p class="eyebrow">Selected writing &amp; making</p><h2
        id="publications-title"
      >
        Publications
      </h2>
    </div>
  </div>
  <div class="publications-intro">
    <p class="section-lede">
      Research across human–AI interaction, affective computing, and healthcare.
      An asterisk indicates equal contribution.
    </p>
    <div
      class="publication-filters"
      role="group"
      aria-label="Filter publications by topic"
    >
      {
        publicationFilters.map((filter) => (
          <button
            type="button"
            class="pub-filter-btn"
            data-publication-filter={filter.id}
            aria-pressed={filter.id === "all"}
          >
            {filter.label}
            {filter.id === "all" ? ` (${papers.length})` : ""}
          </button>
        ))
      }
    </div>
  </div>
  <p id="publication-count" class="sr-only" role="status" aria-live="polite">
    Showing {papers.length} publications
  </p>
  {
    groups.map((group) => {
      const entries = papers.filter((paper) => paper.group === group.id);
      return (
        <div class="publication-group" data-publication-group={group.id}>
          <div class="publication-group-heading">
            <>
              <h3>
                {group.title} <span data-group-count>{entries.length}</span>
              </h3>
              <span>{group.note}</span>
            </>
          </div>
          <div class="publication-list">
            {entries.map((paper, index) => (
              <PublicationCard publication={paper} index={index + 1} />
            ))}
          </div>
        </div>
      );
    })
  }
</section>
