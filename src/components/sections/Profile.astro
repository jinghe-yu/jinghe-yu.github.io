---
import { site } from "../../data/site";

const experience = [
  {
    time: "Jun 2026 — Present",
    name: "Studio for Narrative Spaces",
    place: "City University of Hong Kong · Hong Kong SAR, China",
    role: "Research Intern · Human-Centered AI for Collaborative Creativity",
    advisor: "Prof. RAY LC",
    highlights: [
      "Led the end-to-end design and full-stack development of LineSpace, a mobile-first social poetry platform that repurposes social-media affordances for feedback-driven revision and attributable, branching co-writing with author-controlled AI assistance.",
      "Designed and conducted formative interviews and a mixed-methods user study with 33 participants; analyzed surveys, interviews, interaction logs, and multilingual poem artifacts using statistical, thematic, and computational methods, culminating in a co-first author full paper submitted to ACM CHI 2027.",
    ],
    relatedPaper: "posts-and-threads",
  },
  {
    time: "May 2025 — Present",
    name: "Human-Centered AI Lab",
    place: "South China University of Technology",
    role: "Research Intern · Affective Computing & HCI",
    detail:
      "Research across data curation, model development, experimental evaluation, and user-centered studies. Advised by Prof. Zhanpeng Jin and Prof. Yang Gao.",
  },
  {
    time: "May 2024 — Present",
    name: "Healthcare Data and Medical Intelligence Lab",
    place: "South China University of Technology",
    role: "Research Intern · Multimodal Healthcare Analytics",
    detail:
      "Work on multimodal health data and AS-OCT image analysis workflows. Advised by Prof. Yanwu Xu.",
  },
  {
    time: "Aug 2024",
    name: "Neusoft Corporation (Guangzhou)",
    place: "South China Region",
    role: "Trainee Software Engineer",
    detail:
      "Implemented and refined software modules, supported debugging, and validated fixes with targeted test cases.",
  },
];

const awards = [
  {
    year: "2025",
    title: "Best Paper Award",
    context: "ICIMH · AS-OCT diagnosis paper",
  },
  {
    year: "2025",
    title: "Third-Class Scholarship",
    context: "South China University of Technology",
  },
  {
    year: "2025",
    title: "Excellence Scholarship",
    context: "South China University of Technology",
  },
  {
    year: "2025",
    title: "University Merit Student",
    context: "South China University of Technology",
  },
  {
    year: "2025",
    title: "First Prize",
    context: "Brain-Inspired Intelligence Innovation Competition · South China",
  },
  {
    year: "2025",
    title: "Third Prize",
    context: "National Biomedical Engineering Competition",
  },
  {
    year: "2025",
    title: "National Undergraduate Innovation Program",
    context: "Project approved and funded",
  },
  {
    year: "2025",
    title: "Third Prize",
    context: "Asia-Pacific Mathematical Modeling Competition",
  },
  {
    year: "2025",
    title: "Third Prize",
    context: "Baidu Brain Cup Competition",
  },
  { year: "2024", title: "Global Bronze Award", context: "iGEM Competition" },
];
---

<section
  id="experience"
  class="content-section"
  aria-labelledby="experience-title"
>
  <div class="section-heading">
    <span class="section-number">05</span><div>
      <p class="eyebrow">Where I work &amp; learn</p><h2 id="experience-title">
        Experience
      </h2>
    </div>
  </div>
  <div class="timeline">
    {
      experience.map((item, index) => (
        <article
          class="timeline-item"
          style={`--timeline-index: ${Math.min(index, 3)}`}
        >
          <div class="timeline-rail">
            <span class="timeline-time">{item.time}</span>
            {index === 0 && <span class="timeline-now">Current</span>}
          </div>
          <div class="timeline-body">
            <>
              <h3>{item.name}</h3>
              <p class="timeline-place">{item.place}</p>
              <p class="timeline-role">{item.role}</p>
              {item.advisor && (
                <p class="timeline-advisor">Advisor: {item.advisor}</p>
              )}
              {item.highlights ? (
                <ul class="timeline-highlights">
                  {item.highlights.map((highlight) => (
                    <li>{highlight}</li>
                  ))}
                </ul>
              ) : (
                <p class="timeline-detail">{item.detail}</p>
              )}
              {item.relatedPaper && (
                <a class="timeline-paper-link" href={`#${item.relatedPaper}`}>
                  Explore the LineSpace paper <span aria-hidden="true">↗</span>
                </a>
              )}
            </>
          </div>
        </article>
      ))
    }
  </div>
</section>

<section
  id="education"
  class="content-section"
  aria-labelledby="education-title"
>
  <div class="section-heading">
    <span class="section-number">06</span><div>
      <p class="eyebrow">Foundation</p><h2 id="education-title">Education</h2>
    </div>
  </div>
  <div class="education-card">
    <div class="education-top">
      <span class="eyebrow">Sep 2023 — Jun 2027</span><span
        class="education-emblem"
        aria-hidden="true">✳</span
      >
    </div>
    <h3>South China University of Technology</h3>
    <p>Undergraduate student in Artificial Intelligence · Guangzhou, China</p>
    <div class="education-stats">
      <span>CGPA <strong>3.55 / 4.00</strong></span><span
        >Average <strong>87.27 / 100</strong></span
      ><span>IELTS <strong>6.5</strong></span>
    </div>
    <details class="course-details">
      <summary>Selected coursework <span aria-hidden="true">＋</span></summary
      ><p>
        Machine Learning Course Design (95) · Introduction to Artificial
        Intelligence (98) · Digital Image Processing (96) · Cognitive
        Neuroscience (95) · Design Thinking Innovation and Practice (87)
      </p>
    </details>
  </div>
</section>

<section id="awards" class="content-section" aria-labelledby="awards-title">
  <div class="section-heading">
    <span class="section-number">07</span><div>
      <p class="eyebrow">Little milestones, shared efforts</p><h2
        id="awards-title"
      >
        Selected honors
      </h2>
    </div>
  </div>
  <div class="awards-list">
    {
      awards.map((award) => (
        <div class="award-item">
          <>
            <span class="award-star" aria-hidden="true">
              ✦
            </span>
            <span class="award-year">{award.year}</span>
            <div>
              <>
                <strong>{award.title}</strong>
                <span>{award.context}</span>
              </>
            </div>
          </>
        </div>
      ))
    }
  </div>
  <div class="closing-note">
    <span aria-hidden="true">✳</span><p>
      Interested in building AI that makes space for people. If our questions
      overlap, I'd love to hear from you.
    </p><a href={`mailto:${site.email}`}>Start a conversation ↗</a>
  </div>
</section>
