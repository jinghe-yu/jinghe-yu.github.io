---
import { site } from "../../data/site";
import ExperiencePapers from "../ExperiencePapers.astro";

interface ExperienceItem {
  time: string;
  name: string;
  place: string;
  role: string;
  advisor?: string;
  advisorLabel?: string;
  highlights?: string[];
  detail?: string;
  labUrl?: string;
  labLabel?: string;
  paperIds?: string[];
}

// Related paper IDs follow the lab advisors/coauthors named in the current CV.
const experience: ExperienceItem[] = [
  {
    time: "Jun 2026 — Present",
    name: "Studio for Narrative Spaces",
    place: "City University of Hong Kong · Hong Kong SAR, China",
    role: "Research Intern · Human-Centered AI for Collaborative Creativity",
    advisor: "Prof. RAY LC",
    labUrl: "https://recfro.github.io/",
    labLabel: "Studio website",
    highlights: [
      "Led the end-to-end design and full-stack development of LineSpace, a mobile-first social poetry platform that repurposes social-media affordances for feedback-driven revision and attributable, branching co-writing with author-controlled AI assistance.",
      "Designed and conducted formative interviews and a mixed-methods user study with 33 participants; analyzed surveys, interviews, interaction logs, and multilingual poem artifacts using statistical, thematic, and computational methods, culminating in a co-first author full paper submitted to ACM CHI 2027.",
    ],
    paperIds: ["posts-and-threads"],
  },
  {
    time: "May 2025 — Present",
    name: "Human-Centered AI Lab (HAI Lab)",
    place: "South China University of Technology · Guangzhou, China",
    role: "Research Intern · Affective Computing & Human–Computer Interaction",
    advisor: "Prof. Zhanpeng Jin and Prof. Yang Gao",
    advisorLabel: "Advisors",
    labUrl: "https://scuthcc.top/",
    labLabel: "Lab website",
    highlights: [
      "Conduct end-to-end affective computing and HCI research, from data curation and model development to reproducible experimental evaluation; build pipelines for preprocessing, annotation quality control, and consistent reporting.",
      "Design and run user-centered studies—including protocols, tasks, and analysis—and translate findings into iterations of models and interactive prototypes.",
    ],
    paperIds: [
      "emomirror26",
      "emotype26",
      "touchsound26",
      "aicabench26",
      "liqo",
      "mental-health",
      "sentiment-boundaries",
      "ac-bench",
    ],
  },
  {
    time: "May 2024 — Present",
    name: "Healthcare Data and Medical Intelligence Lab",
    place: "South China University of Technology · Guangzhou, China",
    role: "Research Intern · Multimodal Healthcare Analytics",
    advisor: "Prof. Yanwu Xu",
    labUrl: "http://hdmilab.cn/",
    labLabel: "Lab website",
    highlights: [
      "Research multimodal health data, including clinical records and imaging, for data-driven healthcare analytics and decision support.",
      "Develop and evaluate AS-OCT image analysis workflows spanning preprocessing, feature and representation learning, prediction, segmentation, and classification.",
    ],
    paperIds: ["icimh2025", "scidata26"],
  },
  {
    time: "Aug 2024",
    name: "Neusoft Corporation (Guangzhou)",
    place: "South China Region",
    role: "Trainee Software Engineer",
    detail:
      "Implemented and refined software modules, supported debugging, and validated fixes with targeted test cases.",
  },
];

const awards = [
  {
    year: "2025",
    title: "Best Paper Award",
    context: "ICIMH · AS-OCT diagnosis paper",
  },
  {
    year: "2025",
    title: "Third-Class Scholarship",
    context: "South China University of Technology",
  },
  {
    year: "2025",
    title: "Excellence Scholarship",
    context: "South China University of Technology",
  },
  {
    year: "2025",
    title: "University Merit Student",
    context: "South China University of Technology",
  },
  {
    year: "2025",
    title: "First Prize",
    context: "Brain-Inspired Intelligence Innovation Competition · South China",
  },
  {
    year: "2025",
    title: "Third Prize",
    context: "National Biomedical Engineering Competition",
  },
  {
    year: "2025",
    title: "National Undergraduate Innovation Program",
    context: "Project approved and funded",
  },
  {
    year: "2025",
    title: "Third Prize",
    context: "Asia-Pacific Mathematical Modeling Competition",
  },
  {
    year: "2025",
    title: "Third Prize",
    context: "Baidu Brain Cup Competition",
  },
  { year: "2024", title: "Global Bronze Award", context: "iGEM Competition" },
];
---

<section
  id="experience"
  class="content-section"
  aria-labelledby="experience-title"
>
  <div class="section-heading">
    <span class="section-number">04</span>
    <h2 id="experience-title">Experience</h2>
  </div>
  <div class="timeline">
    {
      experience.map((item, index) => (
        <article
          class="timeline-item"
          style={`--timeline-index: ${Math.min(index, 3)}`}
        >
          <div class="timeline-rail">
            <span class="timeline-time">{item.time}</span>
            {index === 0 && <span class="timeline-now">Current</span>}
          </div>
          <div class="timeline-body">
            <>
              <div class="timeline-title-row">
                <h3>{item.name}</h3>
                {item.labUrl && (
                  <a
                    class="timeline-lab-link"
                    href={item.labUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label={`${item.labLabel} for ${item.name} (opens in a new tab)`}
                  >
                    <span>{item.labLabel}</span>
                    <svg aria-hidden="true" viewBox="0 0 16 16" fill="none">
                      <path
                        d="M6 3H3.5A1.5 1.5 0 0 0 2 4.5v8A1.5 1.5 0 0 0 3.5 14h8a1.5 1.5 0 0 0 1.5-1.5V10M8 2h6v6M14 2 7.5 8.5"
                        stroke="currentColor"
                        stroke-width="1.3"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      />
                    </svg>
                  </a>
                )}
              </div>
              <p class="timeline-place">{item.place}</p>
              <p class="timeline-role">{item.role}</p>
              {item.advisor && (
                <p class="timeline-advisor">
                  {item.advisorLabel ?? "Advisor"}: {item.advisor}
                </p>
              )}
              {item.highlights ? (
                <ul class="timeline-highlights">
                  {item.highlights.map((highlight) => (
                    <li>{highlight}</li>
                  ))}
                </ul>
              ) : (
                <p class="timeline-detail">{item.detail}</p>
              )}
              {item.paperIds && <ExperiencePapers ids={item.paperIds} />}
            </>
          </div>
        </article>
      ))
    }
  </div>
</section>

<section
  id="education"
  class="content-section"
  aria-labelledby="education-title"
>
  <div class="section-heading">
    <span class="section-number">05</span>
    <h2 id="education-title">Education</h2>
  </div>
  <div class="education-card">
    <div class="education-top">
      <span class="eyebrow">Sep 2023 — Jun 2027</span><span
        class="education-emblem"
        aria-hidden="true">✳</span
      >
    </div>
    <h3>South China University of Technology</h3>
    <p>Undergraduate student in Artificial Intelligence · Guangzhou, China</p>
    <div class="education-stats">
      <span>CGPA <strong>3.55 / 4.00</strong></span><span
        >Average <strong>87.27 / 100</strong></span
      ><span>IELTS <strong>6.5</strong></span><span
        >CET-6 <strong>577</strong></span
      ><span>CET-4 <strong>608</strong></span>
    </div>
    <details class="course-details">
      <summary>Selected coursework <span aria-hidden="true">＋</span></summary
      ><p>
        Machine Learning Course Design (95) · Introduction to Artificial
        Intelligence (98) · Digital Image Processing (96) · Cognitive
        Neuroscience (95) · Design Thinking Innovation and Practice (87)
      </p>
    </details>
  </div>
</section>

<section id="awards" class="content-section" aria-labelledby="awards-title">
  <div class="section-heading">
    <span class="section-number">06</span>
    <h2 id="awards-title">Selected honors</h2>
  </div>
  <div class="awards-list">
    {
      awards.map((award) => (
        <div class="award-item">
          <>
            <span class="award-star" aria-hidden="true">
              ✦
            </span>
            <span class="award-year">{award.year}</span>
            <div>
              <>
                <strong>{award.title}</strong>
                <span>{award.context}</span>
              </>
            </div>
          </>
        </div>
      ))
    }
  </div>
  <div class="closing-note">
    <span aria-hidden="true">✳</span><p>
      Interested in building AI that makes space for people. If our questions
      overlap, I'd love to hear from you.
    </p><a href={`mailto:${site.email}`}>Start a conversation ↗</a>
  </div>
</section>
