---
import { site } from "../data/site";

const tabs = [
  ["about", "About"],
  ["news", "News"],
  ["research", "Research"],
  ["publications", "Publications"],
  ["experience", "Experience"],
  ["education", "Education"],
  ["awards", "Awards"],
];
---

<header class="site-header">
  <div class="header-inner">
    <a class="brand" href="#about" aria-label={`${site.name}, back to About`}>
      <span class="brand-mark" aria-hidden="true">j<span>✦</span>y</span>
      <span class="brand-name">Jinghe Yu</span>
    </a>
    <nav class="section-nav" aria-label="Page sections">
      {
        tabs.map(([id, label]) => (
          <a class="section-tab" href={`#${id}`} data-nav-link={id}>
            {label}
          </a>
        ))
      }
    </nav>
    <a
      class="header-contact"
      href={`mailto:${site.email}`}
      aria-label="Email Jinghe Yu"
    >
      <span>Let's talk</span><span aria-hidden="true">↗</span>
    </a>
  </div>
</header>
