---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import ProfileSidebar from "../components/ProfileSidebar.astro";
import Hero from "../components/sections/Hero.astro";
import Updates from "../components/sections/Updates.astro";
import Expertise from "../components/sections/Expertise.astro";
import Publications from "../components/sections/Publications.astro";
import Profile from "../components/sections/Profile.astro";
---

<BaseLayout>
  <SiteHeader />
  <div class="site-shell">
    <ProfileSidebar />
    <div class="reading-column">
      <main id="main" class="site-main">
        <Hero />
        <Updates />
        <Expertise />
        <Publications />
        <Profile />
      </main>
      <SiteFooter />
    </div>
  </div>
</BaseLayout>
